# Copy this file to .env and fill in your key to enable Chitti's language + vision core.
# Without a key, Chitti still runs: object detection, voice commands, document search,
# Wikipedia and missions all work offline — only open conversation and scene analysis need it.
ANTHROPIC_API_KEY=

# Optional overrides
# CHITTI_MODEL=claude-opus-5
# PORT=8787

# Offline language core (used when no Anthropic key works). Chitti starts Ollama
# automatically if it is installed. Pull a model once with:  ollama pull llama3.2
# OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_AUTOSTART=false
